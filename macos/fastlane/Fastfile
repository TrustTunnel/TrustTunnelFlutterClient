ensure_bundle_exec

require 'fileutils'
require 'tmpdir'


lane :build_macos_app do |options|
    type = options[:type]

    app_store_connect_api_key

    signing_config = {
        "development"  => {
            match:         "Development",
            identity:      "Apple Development",
            export_method: "development",
        },
        "appstore"     => {
            match:         "AppStore",
            identity:      "Apple Distribution",
            export_method: "app-store",
        }
    }

    config = signing_config.fetch(type) do
      UI.user_error!(
        "Unknown signing type: #{type}. " \
        "Expected: development, appstore"
      )
    end

    signing_targets = ENV.fetch('SIGNING_TARGETS')
                         .split(',')
                         .map { |pair| pair.split(':', 2) }

    # fastlane match names macOS profiles "match <Type> <bundle id> macos".
    provisioning_profiles = signing_targets.each_with_object({}) do |(_target_name, bundle_id), mapping|
      mapping[bundle_id] = "match #{config[:match]} #{bundle_id} macos"
    end

    signing_targets.each do |target_name, bundle_id|
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        use_automatic_signing: false,
        team_id: ENV.fetch('TEAM_ID'),
        code_sign_identity: config[:identity],
        profile_name: provisioning_profiles.fetch(bundle_id),
        targets: [target_name],
        build_configurations: ["Release"]
      )
    end

    # Some Xcode targets (e.g. helper apps or bundled frameworks) do not use a
    # provisioning profile. Attempting to set one causes a build error
    # ("Provisioning profile has app ID … which does not match the bundle ID …").
    #
    # SIGNING_TARGETS_NO_PROFILE is a comma-separated list of these target names.
    # When populated, this loop runs update_code_signing_settings for each target
    # with an EMPTY profile_name string. This tells Xcode to use manual signing
    # with the specified certificate identity but NO provisioning profile.
    no_profile_targets = ENV.fetch('SIGNING_TARGETS_NO_PROFILE', '')
                            .split(',').map(&:strip).reject(&:empty?)

    no_profile_targets.each do |target_name|
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        use_automatic_signing: false,
        team_id: ENV.fetch('TEAM_ID'),
        code_sign_identity: config[:identity],
        profile_name: "",
        targets: [target_name],
        build_configurations: ["Release"]
      )
    end

    if ENV['MATCH_KEYCHAIN_NAME'] && !ENV['MATCH_KEYCHAIN_NAME'].empty?
      unlock_keychain(
        path: ENV['MATCH_KEYCHAIN_NAME'],
        password: ENV.fetch('MATCH_KEYCHAIN_PASSWORD', ''),
        add_to_search_list: true,
        set_default: false
      )
    end

    build_mac_app(
        scheme: ENV['CUSTOM_FASTLANE_SCHEMA'],
        output_directory: ENV['FASTLANE_BUILD_DIRECTORY'],
        output_name: ENV['CUSTOM_FASTLANE_BUILD_NAME'],
        include_symbols: true,
        archive_path: "#{ENV['FASTLANE_BUILD_DIRECTORY']}/#{ENV['CUSTOM_FASTLANE_BUILD_NAME']}.xcarchive",
        derived_data_path: "#{ENV['FASTLANE_BUILD_DIRECTORY']}/derived_data",
        buildlog_path: "#{ENV['FASTLANE_BUILD_DIRECTORY']}/logs",
        build_path: ENV['FASTLANE_BUILD_DIRECTORY'],
        export_method: config[:export_method],
        export_options: {
            manageAppVersionAndBuildNumber: type == "appstore",
            generateAppStoreInformation: type == "appstore",
            signingStyle: "manual",
            signingCertificate: config[:identity],
            provisioningProfiles: provisioning_profiles
        }
    )
end
